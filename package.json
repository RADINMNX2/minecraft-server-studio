{
  "name": "minecraft-server-studio",
  "version": "1.0.0",
  "description": "Professional, modern Minecraft server manager built with Electron, React, Rust and Node.js",
  "license": "MIT",
  "author": "MCSS Team",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:ci": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@pinggy/pinggy": "^0.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
